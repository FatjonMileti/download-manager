{
  "name": "download-manager",
  "version": "1.0.0",
  "description": "Cross-platform Electron Download Manager with YouTube video extraction",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.downloadmanager.app",
    "productName": "Download Manager",
    "linux": {
      "target": ["AppImage"],
      "category": "Utility",
      "icon": null
    },
    "extraResources": [],
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "asar": false
  },
  "dependencies": {
    "@distube/ytdl-core": "^4.16.6",
    "fluent-ffmpeg": "^2.1.3"
  },
  "devDependencies": {
    "electron": "^34.3.0",
    "electron-builder": "^26.8.1"
  }
}
